<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>AspectCentral.DispatchProxy</PackageId>
        <Description>Aspect-oriented programming for Microsoft.Extensions.DependencyInjection built on System.Reflection.DispatchProxy. Wrap registered services with logging, profiling, or custom aspects without changing call sites; consumers configure their own logging sinks and OpenTelemetry exporters.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>AOP, aspect oriented programming, interceptors, DispatchProxy</PackageTags>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <ProjectGuid>5112A87D-F8F2-43A5-B566-9F104BC83954</ProjectGuid>
        <TargetFrameworks>net9.0;net10.0;netstandard2.1</TargetFrameworks>
        <!--
            NU1902 is suppressed for the transitive MessagePack 2.3.85 vulnerability
            (GHSA-4qm4-8hg2-g2xm: hash-collision DoS when deserializing UNTRUSTED data).
            MessagePack arrives via JamesConsulting 1.0.1 -> MessagePack 2.3.85.
            This library is an AOP/DI helper and never deserializes external data, so
            no execution path here is exposed to the documented attack surface. We
            deliberately do not add a direct override (which would pollute every
            downstream consumer's dependency closure) and instead track the upstream
            JamesConsulting package for a refreshed transitive.
            Tracking: bump JamesConsulting once a release without MessagePack 2.3.x ships.
        -->
        <NoWarn>$(NoWarn);NU1902</NoWarn>
        <Title>AspectCentral.DispatchProxy</Title>
        <PackageProjectUrl>https://github.com/jamesconsultingllc/AspectCentral.DispatchProxy/projects</PackageProjectUrl>
        <RepositoryUrl>https://github.com/jamesconsultingllc/AspectCentral.DispatchProxy</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <PropertyGroup>
        <VersionMajor>2</VersionMajor>
        <VersionMinor>0</VersionMinor>
        <VersionBuild>0</VersionBuild>
    </PropertyGroup>

    <PropertyGroup>
        <VersionPrefix Condition=" '$(BUILD_BUILDNUMBER)' == '' ">$(VersionMajor).$(VersionMinor).$(VersionBuild)-local</VersionPrefix>
        <VersionPrefix Condition=" '$(BUILD_BUILDNUMBER)' != '' And '$(Configuration)' == 'Debug' ">$(VersionMajor).$(VersionMinor).$(VersionBuild)-$(BUILD_BUILDNUMBER)-preview</VersionPrefix>
        <VersionPrefix Condition=" '$(BUILD_BUILDNUMBER)' != '' And '$(Configuration)' != 'Debug' ">$(VersionMajor).$(VersionMinor).$(VersionBuild)</VersionPrefix>
    </PropertyGroup>
    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="AspectCentral.Abstractions" Version="1.0.2" />
        <PackageReference Include="JamesConsulting" Version="1.0.1" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.2" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.2" />
        <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="9.0.2" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.11.0-beta1.24454.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    </ItemGroup>
</Project>
